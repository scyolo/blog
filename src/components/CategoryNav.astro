---
import { getAssetPath } from "@/utils/withBase";
const items = [
  { href: "/posts/", label: "全部" },
  { href: "/categories/knowledge/", label: "知识笔记" },
  { href: "/categories/essay/", label: "随笔" },
];
---

<nav class="category-nav" aria-label="文章栏目">
  {items.map(item => (
    <a
      href={getAssetPath(item.href)}
      aria-current={
        Astro.url.pathname.startsWith(getAssetPath(item.href))
          ? "page"
          : undefined
      }
    >
      {item.label}
    </a>
  ))}
</nav>
