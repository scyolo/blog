---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "../lib/lists";
import { categories } from "../lib/site-content";
interface Props {
  post: CollectionEntry<"posts">;
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
---

<article class:list={["post-card", { "no-cover": !post.data.cover }]}>
  <a
    class="card-link"
    href={"/posts/" + post.id + "/"}
    aria-label={post.data.title + (post.data.demo ? "（示例文章）" : "")}
  >
    {post.data.cover && (
      <div class="card-image">
        <Image
          src={post.data.cover}
          alt=""
          widths={
            post.data.cover.format === "svg" ? undefined : [360, 600, 960]
          }
          sizes={
            post.data.cover.format === "svg"
              ? undefined
              : "(max-width: 680px) 100vw, (max-width: 1000px) 50vw, 33vw"
          }
          loading={eager ? "eager" : "lazy"}
        />
      </div>
    )}
    <div class="card-body">
      <div class="card-meta">
        <span>{categories[post.data.category]}</span>
        <time datetime={post.data.pubDatetime.toISOString()}>
          {formatDate(post.data.pubDatetime)}
        </time>
      </div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <div class="card-bottom">
        <span>{post.data.demo ? "示例文章" : "阅读文章"}</span>
        <span class="card-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
    </div>
  </a>
</article>
