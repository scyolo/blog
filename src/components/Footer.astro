---
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
const year = new Intl.DateTimeFormat("en", {
  year: "numeric",
  timeZone: "Asia/Shanghai",
}).format(new Date());
---

<footer class="site-footer shell">
  <div>
    <a class="footer-brand" href={getAssetPath("/")}>
      行间
    </a>
    <p>在理解中积累，在写作中看见。</p>
    <small>
      © {year} {config.site.author}
    </small>
  </div>
  <nav aria-label="页脚导航">
    <a href={getAssetPath("/tags/")}>标签</a>
    <a href={getAssetPath("/rss.xml")}>RSS 订阅</a>
    {config.socials.map(link => (
      <a href={link.url} rel="me">
        {link.name === "github"
          ? "GitHub"
          : link.name === "mail"
            ? "邮件联系"
            : link.name}
      </a>
    ))}
  </nav>
</footer>
