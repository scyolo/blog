---
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import Search from "@/assets/icons/IconSearch.svg";
import Moon from "@/assets/icons/IconMoon.svg";
import Sun from "@/assets/icons/IconSunHigh.svg";
import Menu from "@/assets/icons/IconMenuDeep.svg";
const navigation = [
  { href: "/posts/", label: "文章" },
  { href: "/projects/", label: "项目" },
  { href: "/archives/", label: "归档" },
  { href: "/about/", label: "关于" },
];
const active = (href: string) =>
  Astro.url.pathname.startsWith(getAssetPath(href));
---

<a class="skip-link" href="#main-content">
  跳转到正文
</a>
<header class="site-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href={getAssetPath("/")}
      aria-label={config.site.title + " 首页"}
    >
      <span class="brand-mark" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="brand-type">
        <strong>行间</strong>
        <small>{config.site.author} / notes</small>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map(item => (
        <a
          href={getAssetPath(item.href)}
          aria-current={active(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a
        class="icon-button"
        href={getAssetPath("/search/")}
        aria-label="搜索文章"
      >
        <Search aria-hidden="true" />
      </a>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="切换亮暗主题"
        aria-pressed="false"
        data-theme-toggle
      >
        <Moon class="theme-moon" aria-hidden="true" />
        <Sun class="theme-sun" aria-hidden="true" />
      </button>
      <details class="mobile-menu">
        <summary class="icon-button" aria-label="展开导航">
          <Menu aria-hidden="true" />
        </summary>
        <nav aria-label="移动导航">
          {navigation.map(item => (
            <a
              href={getAssetPath(item.href)}
              aria-current={active(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href={getAssetPath("/tags/")}>标签</a>
        </nav>
      </details>
    </div>
  </div>
</header>
