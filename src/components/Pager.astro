---
import { pageHref } from "../lib/lists";
interface Props {
  base: string;
  current: number;
  total: number;
}
const { base, current, total } = Astro.props;
---

{total > 1 && (
  <nav class="pagination" aria-label="文章分页">
    {current > 1 ? (
      <a href={pageHref(base, current - 1)} rel="prev">
        ← 上一页
      </a>
    ) : (
      <span></span>
    )}
    <span>
      第 {current} / {total} 页
    </span>
    {current < total ? (
      <a href={pageHref(base, current + 1)} rel="next">
        下一页 →
      </a>
    ) : (
      <span></span>
    )}
  </nav>
)}
