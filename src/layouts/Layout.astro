---
import config from "@/config";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import "@/styles/global.css";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}
const {
  title = config.site.title,
  description = config.site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = "website",
  noindex = false,
} = Astro.props;
const image = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="zh-CN" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f7f2" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={new URL("/rss.xml", Astro.site).href}
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {config.site.googleVerification && (
      <meta
        name="google-site-verification"
        content={config.site.googleVerification}
      />
    )}
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark =
          saved === "dark" ||
          (saved !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
