---
import SiteLayout from "../layouts/SiteLayout.astro";
import config from "../config";
---

<SiteLayout title={"404 · " + config.site.title} noindex={true}>
  <section class="not-found">
    <span class="not-found-number" aria-hidden="true">
      404
    </span>
    <p class="eyebrow">A PAGE YET TO BE WRITTEN</p>
    <h1>这一页还没有写下。</h1>
    <p>地址可能有误，或者这篇内容已经下架。</p>
    <a class="text-link" href="/">
      回到首页
    </a>
  </section>
</SiteLayout>
