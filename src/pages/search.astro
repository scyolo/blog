---
import { getAssetPath } from "@/utils/withBase";
import SiteLayout from "../layouts/SiteLayout.astro";
import config from "../config";
import { getPosts } from "../lib/site-content";
const hasPosts = (await getPosts()).length > 0;
import "@pagefind/default-ui/css/ui.css";
---

<SiteLayout
  title={"搜索 · " + config.site.title}
  description="搜索本站已发布文章的标题与正文。"
  noindex={true}
>
  <header class="page-heading">
    <p class="eyebrow">FIND A NOTE</p>
    <h1>搜索</h1>
    <p>输入一个关键词，寻找相关的文章。</p>
  </header>
  {hasPosts ? (
    <div class="search-shell">
      <label id="search-label" class="search-label" for="blog-search-input">
        搜索关键词
      </label>
      <div id="pagefind-search"></div>
      <p id="search-status" role="status">
        正在准备本地搜索索引…
      </p>
    </div>
  ) : (
    <div class="empty-state">
      <h2>还没有已发布文章。</h2>
      <p>新的记录发布后，就可以在这里搜索了。</p>
      <a href={getAssetPath("/posts/")}>浏览文章列表</a>
    </div>
  )}
</SiteLayout>
<script>
  import { getAssetPath } from "@/utils/withBase";
  const status = document.querySelector<HTMLElement>("#search-status");
  async function initSearch() {
    try {
      const initialQuery = new URLSearchParams(location.search).get("q");
      const { PagefindUI } = await import("@pagefind/default-ui");
      const ui = new PagefindUI({
        element: "#pagefind-search",
        baseUrl: import.meta.env.BASE_URL,
        bundlePath: getAssetPath("/pagefind/"),
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: "搜索文章…",
          clear_search: "清除",
          load_more: "加载更多",
          search_label: "搜索文章",
          searching: "正在搜索…",
          zero_results: "未找到 [SEARCH_TERM] 的结果",
          one_result: "找到 [COUNT] 篇文章",
          many_results: "找到 [COUNT] 篇文章",
        },
        processTerm: (term: string) => {
          const params = new URLSearchParams();
          if (term) params.set("q", term);
          history.replaceState(
            null,
            "",
            getAssetPath("/search/") + (term ? "?" + params.toString() : "")
          );
          return term;
        },
      });
      const input = document.querySelector<HTMLInputElement>(
        "#pagefind-search input"
      );
      if (input) {
        input.id = "blog-search-input";
        input.setAttribute("aria-labelledby", "search-label");
      }
      if (status) status.hidden = true;
      if (initialQuery) ui.triggerSearch(initialQuery);
    } catch {
      if (status)
        status.textContent =
          "搜索索引暂时不可用。本地开发请先运行 pnpm build，再使用 pnpm preview。";
    }
  }
  if (document.querySelector("#pagefind-search") && import.meta.env.DEV) {
    if (status)
      status.textContent =
        "搜索使用生产索引，请先 pnpm build，再使用 pnpm preview。";
  } else if (document.querySelector("#pagefind-search")) {
    initSearch();
  }
</script>
