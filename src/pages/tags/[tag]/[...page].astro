---
import { getAssetPath } from "@/utils/withBase";
import type { CollectionEntry } from "astro:content";
import type { PageSlice } from "../../../lib/lists";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import PostListing from "../../../components/PostListing.astro";
import { getPosts } from "../../../lib/site-content";
import { groupTags, paginate } from "../../../lib/lists";
import config from "../../../config";
export async function getStaticPaths() {
  return groupTags(await getPosts()).flatMap(topic =>
    paginate(topic.posts, config.posts.perPage).map(page => ({
      params: {
        tag: topic.id,
        page: page.number === 1 ? undefined : String(page.number),
      },
      props: { page, topicId: topic.id, label: topic.label },
    }))
  );
}
interface Props {
  page: PageSlice<CollectionEntry<"posts">>;
  label: string;
  topicId: string;
}
const { page, label, topicId } = Astro.props;
---

<SiteLayout title={label + " · 标签 · " + config.site.title}>
  <header class="page-heading">
    <a class="back-link" href={getAssetPath("/tags/")}>
      ← 所有标签
    </a>
    <h1>{label}</h1>
    <p>这个主题下，有 {page.totalItems} 篇记录。</p>
  </header>
  <PostListing page={page} base={"/tags/" + topicId + "/"} />
</SiteLayout>
