---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPosts } from "../../lib/site-content";
import { groupTags } from "../../lib/lists";
import config from "../../config";
const topics = groupTags(await getPosts());
---

<SiteLayout title={"标签 · " + config.site.title}>
  <header class="page-heading">
    <p class="eyebrow">FOLLOW A THREAD</p>
    <h1>标签</h1>
    <p>沿着一个主题，发现更多相关的记录。</p>
  </header>
  <div class="topic-grid">
    {topics.map(topic => (
      <a href={"/tags/" + topic.id + "/"}>
        <span>{topic.label}</span>
        <small>{topic.posts.length} 篇</small>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
  {!topics.length && (
    <p class="empty-state">有了文章之后，主题也会慢慢出现。</p>
  )}
</SiteLayout>
