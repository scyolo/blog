---
import { getAssetPath } from "@/utils/withBase";
import { type CollectionEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ArticleToc from "../../../components/ArticleToc.astro";
import { getPosts, categories } from "../../../lib/site-content";
import { formatDate, tagId } from "../../../lib/lists";
import { jsonForScript } from "../../../lib/serialization";
import config from "../../../config";
import "katex/dist/katex.min.css";
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}
interface Props {
  post: CollectionEntry<"posts">;
  older?: CollectionEntry<"posts">;
  newer?: CollectionEntry<"posts">;
}
const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const hasToc = headings.some(
  heading => heading.depth === 2 || heading.depth === 3
);
const og =
  post.data.cover && post.data.cover.format !== "svg"
    ? (
        await getImage({
          src: post.data.cover,
          format: "png",
          width: 1200,
          height: 630,
          fit: "cover",
        })
      ).src
    : getAssetPath("/default-og.png");
const canonical = new URL(getAssetPath("/posts/" + post.id + "/"), Astro.site)
  .href;
const structured = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDatetime.toISOString(),
  dateModified: (post.data.modDatetime ?? post.data.pubDatetime).toISOString(),
  author: { "@type": "Person", name: post.data.author },
  image: new URL(og, Astro.site).href,
  mainEntityOfPage: canonical,
};
---

<SiteLayout
  title={post.data.title + " · " + config.site.title}
  description={post.data.description}
  ogImage={og}
  ogType="article"
  canonicalURL={canonical}
  class="article-page"
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.pubDatetime.toISOString()}
    />
    {post.data.modDatetime && (
      <meta
        property="article:modified_time"
        content={post.data.modDatetime.toISOString()}
      />
    )}
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonForScript(structured)}
    />
  </Fragment>
  <div class:list={["article-layout", { "has-toc": hasToc }]}>
    <div class="article-main" data-pagefind-body>
      <header class="article-heading">
        <a
          class="back-link"
          href={getAssetPath("/posts/")}
          data-pagefind-ignore
        >
          ← 所有文章
        </a>
        <div class="article-meta" data-pagefind-ignore>
          <a href={getAssetPath("/categories/" + post.data.category + "/")}>
            {categories[post.data.category]}
          </a>
          <time datetime={post.data.pubDatetime.toISOString()}>
            {formatDate(post.data.pubDatetime)}
          </time>
          {post.data.demo && <span class="demo-badge">示例文章</span>}
        </div>
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        {post.data.modDatetime && (
          <p class="updated-date" data-pagefind-ignore>
            更新于 {formatDate(post.data.modDatetime)}
          </p>
        )}
      </header>
      <article id="article" class="app-prose">
        <Content />
      </article>
      <footer class="article-footer" data-pagefind-ignore>
        <ul class="article-tags" aria-label="文章标签">
          {post.data.tags.map(tag => (
            <li>
              <a href={getAssetPath("/tags/" + tagId(tag) + "/")}>{tag}</a>
            </li>
          ))}
        </ul>
        <a class="back-top" href="#main-content">
          回到顶部 ↑
        </a>
      </footer>
      <nav class="adjacent-posts" aria-label="前后文章" data-pagefind-ignore>
        {older ? (
          <a href={getAssetPath("/posts/" + older.id + "/")}>
            <small>← 较早一篇</small>
            <span>{older.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {newer ? (
          <a href={getAssetPath("/posts/" + newer.id + "/")}>
            <small>较新一篇 →</small>
            <span>{newer.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </div>
    <ArticleToc headings={headings} />
  </div>
  <script>
    import "../../../scripts/article";
  </script>
</SiteLayout>
