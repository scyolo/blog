---
import type { CollectionEntry } from "astro:content";
import type { PageSlice } from "../../lib/lists";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostListing from "../../components/PostListing.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { getPosts } from "../../lib/site-content";
import { paginate } from "../../lib/lists";
import config from "../../config";
export async function getStaticPaths() {
  return paginate(await getPosts(), config.posts.perPage).map(page => ({
    params: { page: page.number === 1 ? undefined : String(page.number) },
    props: { page },
  }));
}
interface Props {
  page: PageSlice<CollectionEntry<"posts">>;
}
const { page } = Astro.props;
---

<SiteLayout
  title={"文章 · " + config.site.title}
  description="技术、思考与日常，按时间慢慢积累。"
>
  <header class="page-heading">
    <p class="eyebrow">THE ARCHIVE OF IDEAS</p>
    <h1>文章</h1>
    <p>技术、思考与日常，按时间慢慢积累。</p>
  </header>
  <CategoryNav />
  <PostListing page={page} base="/posts/" />
</SiteLayout>
