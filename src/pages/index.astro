---
import { getAssetPath } from "@/utils/withBase";
import SiteLayout from "../layouts/SiteLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/site-content";
import config from "../config";
const posts = await getPosts();
---

<SiteLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">SCYOLO / A PERSONAL NOTEBOOK</p>
      <h1>
        把学到的，写下来。
        <br />
        <span>把日常的，留下来。</span>
      </h1>
      <p class="hero-description">
        关于技术、思考与生活的片段，
        <br class="desktop-only" />
        都收在这些页面里。
      </p>
      <div class="hero-links">
        <a class="text-link" href={getAssetPath("/posts/")}>
          开始阅读 <span aria-hidden="true">↗</span>
        </a>
        <a href={getAssetPath("/about/")}>认识这个小站</a>
      </div>
    </div>
    <aside class="hero-note" aria-label="这里的写作方向">
      <p class="eyebrow">BETWEEN THE LINES</p>
      <ol>
        <li>
          <span>01</span>用文字理解问题
        </li>
        <li>
          <span>02</span>让方法可以复现
        </li>
        <li>
          <span>03</span>给日常一点留白
        </li>
      </ol>
      <p class="note-signature">持续记录，慢慢生长。</p>
    </aside>
  </section>
  <section class="home-writing" aria-labelledby="recent-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">RECENT WRITING</p>
        <h2 id="recent-heading">最近的记录</h2>
      </div>
      <a class="text-link" href={getAssetPath("/posts/")}>
        全部文章 <span aria-hidden="true">→</span>
      </a>
    </div>
    {posts.length ? (
      <div class="post-grid">
        {posts.slice(0, config.posts.perIndex).map((post, index) => (
          <PostCard post={post} eager={index < 3} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h3>第一篇文章，还在路上。</h3>
        <p>这里会慢慢积累值得留下的文字。</p>
      </div>
    )}
    {posts.some(post => post.data.demo) && (
      <p class="example-note">
        带「示例」标识的文章用于展示排版与功能，不代表作者真实经历。
      </p>
    )}
  </section>
  <section class="project-teaser">
    <div>
      <p class="eyebrow">LEARN BY BUILDING</p>
      <h2>想法，也可以做出来。</h2>
      <p>从一个小问题开始，把思路变成可以运行的项目。</p>
    </div>
    <a class="text-link" href={getAssetPath("/projects/")}>
      看看项目 <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
