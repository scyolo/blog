---
import { getAssetPath } from "@/utils/withBase";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPosts, categories } from "../../lib/site-content";
import { formatDate } from "../../lib/lists";
import config from "../../config";
const groups = new Map<string, CollectionEntry<"posts">[]>();
for (const post of await getPosts()) {
  const year = new Intl.DateTimeFormat("en", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
  }).format(post.data.pubDatetime);
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
---

<SiteLayout title={"归档 · " + config.site.title}>
  <header class="page-heading">
    <p class="eyebrow">A TIMELINE OF NOTES</p>
    <h1>归档</h1>
    <p>文字留下来，时间就有了可以回看的刻度。</p>
  </header>
  <div class="archive">
    {[...groups].map(([year, posts]) => (
      <section class="archive-year">
        <h2>
          {year}
          <small>{posts.length} 篇</small>
        </h2>
        <ol>
          {posts.map(post => (
            <li>
              <time datetime={post.data.pubDatetime.toISOString()}>
                {formatDate(post.data.pubDatetime).slice(5)}
              </time>
              <a href={getAssetPath("/posts/" + post.id + "/")}>
                {post.data.title}
              </a>
              <span class="archive-category">
                {categories[post.data.category]}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  {!groups.size && <p class="empty-state">暂时没有已发布的文章。</p>}
</SiteLayout>
