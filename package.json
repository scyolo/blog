{
  "name": "scyolo-blog",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:foundation": "node --test tests/foundation.node.mjs",
    "check": "astro check",
    "test": "node --test tests/foundation.node.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:security": "node scripts/audit.mjs",
    "test:build-contract": "node --test tests/build-contract.node.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:e2e": "playwright test",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "artifact:seal": "node scripts/artifact-manifest.mjs seal",
    "artifact:check": "node scripts/artifact-manifest.mjs check",
    "deploy": "node scripts/deploy.mjs",
    "test:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "katex": "0.18.2",
    "mermaid": "12.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@axe-core/playwright": "4.13.0",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "1.63.0",
    "@shikijs/transformers": "^4.4.3",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "pagefind": "^1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "parse5": "8.0.1",
    "fast-xml-parser": "5.11.2",
    "wrangler": "4.148.0",
    "lighthouse": "13.5.0",
    "fast-xml-validator": "1.4.2"
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "katex": "0.18.2",
      "sharp": "0.35.5",
      "fast-xml-parser": "5.11.2"
    }
  }
}
