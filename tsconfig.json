{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "public/pagefind",
    "node_modules",
    ".cache",
    "coverage",
    "playwright-report",
    "test-results",
    "output/playwright"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/astro-paper.config": [
        "./astro-paper.config"
      ]
    }
  }
}
